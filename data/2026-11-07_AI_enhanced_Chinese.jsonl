iations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345404", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796026", "last_name": "Gong", "first_name": "Kai", "contact_author": "false", "submitter": "false"}, {"email": "zhouxinjie@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345405", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796027", "last_name": "Zhou", "first_name": "Xinjie", "contact_author": "false", "submitter": "false"}, {"email": "22432122@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345406", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796028", "last_name": "Ji", "first_name": "Zichun", "contact_author": "false", "submitter": "false"}, {"email": "22432141@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345407", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796029", "last_name": "Zhou", "first_name": "Yinhong", "contact_author": "false", "submitter": "false"}, {"email": "22431230@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345408", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796030", "last_name": "Liu", "first_name": "Peitong", "contact_author": "false", "submitter": "false"}, {"email": "kkv1n63@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345409", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796031", "last_name": "Xu", "first_name": "Kaiwen", "contact_author": "false", "submitter": "false"}, {"email": "y3336li@uwaterloo.ca", "affiliations": {"affiliations": {"org_id": "707130", "org_name": "University of Waterloo", "preferred_name": "University of Waterloo", "org_role": null, "affiliation_id": "11345410", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796032", "last_name": "Li", "first_name": "Yizhen", "contact_author": "false", "submitter": "false"}, {"email": "luyangyu@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "734590", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "11345411", "ordinal": "1", "is_primary": "true"}}, "part_id": "13796033", "last_name": "Yu", "first_name": "Luyang", "contact_author": "false", "submitter": "false"}, {"email": "lxg@zju.edu.cn", "affiliations": {"affiliations": {"org_id": "270711", "org_name": "Zhejiang University", "preferred_name": "Zhejiang University", "org_role": null, "affiliation_id": "7023423", "ordinal": "1", "is_primary": "true"}}, "part_id": "5123942", "last_name": "Liu", "first_name": "Xinggao", "contact_author": "true", "submitter": "false"}]}, "abstract": "Machine-learning prediction of chemical reaction yields is at the forefront of drug discovery. Unfortunately, up to now, we find two major widespread fatal errors in the descriptor sets: (1) essential variables that need to be identified are easily obscured by large amounts of redundant information; (2) different descriptor sets have been reported to achieve good predictive performance, leading to considerable confusion: Are descriptors themselves unimportant, such that different descriptor sets can all achieve good results? Is there no essential set of descriptors? We therefore propose an effective method for identifying essential variables and determining the essential descriptor set through Pearson-correlation diagnosis, ridge-regression dependency deconstruction, and Bayesian optimization. The classic 120-variable C\u2013N cross-coupling yield-prediction system reported by Doyle and colleagues [1] is explored in detail as a benchmark. We find that: (1) only 30 variables are essential, reducing the original descriptor set by 75%; (2) the variable identified as most important in the original study [1] is, in fact, redundant and can be eliminated; and (3) we finally identify the truly most important variable, enabling the underlying structure\u2013reactivity relationship to be revealed. The proposed method has broad applicability in computational chemistry."}}
